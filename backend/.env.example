# TraceKey 2.0 Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB — use placeholder values only
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# JWT — replace locally with a long, random secret
JWT_SECRET=replace_with_a_random_secret

# Hugging Face — never put a real token in this file
HF_API_KEY=your_hugging_face_token_here